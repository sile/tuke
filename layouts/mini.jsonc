[
  // A compact QWERTY keyboard for narrow screens: every key in this layout
  // fits within 80 columns. It carries the keys a shell needs most often and
  // leaves the rest (the extra symbols, Shift, Alt) to a fuller layout chosen
  // by hand.
  //
  // The keys are four columns wide, which is narrow but still wide enough to
  // read a one-character label without the key looking cramped. The rows are
  // laid out so the keys a thumb reaches for - Ctrl, Space, Enter, BSpace -
  // sit near the bottom centre, and the arrow cluster sits at the right end
  // of its own row.

  // Number row: digits with the symbols that need no Shift on the right.
  {"base_position": {"row": 0, "column": 0}},
  {"default_size": {"width": 4, "height": 3}},
  {"key": "Esc", "size": {"width": 6, "height": 3}},
  {"key": "1"},
  {"key": "2"},
  {"key": "3"},
  {"key": "4"},
  {"key": "5"},
  {"key": "6"},
  {"key": "7"},
  {"key": "8"},
  {"key": "9"},
  {"key": "0"},
  {"key": "-"},
  {"key": "."},
  {"key": "_"},
  {"key": "/"},
  {"newline": 1},

  // Upper letter row, with its symbols on the right.
  {"key": "Tab", "size": {"width": 6, "height": 3}},
  {"key": "q"},
  {"key": "w"},
  {"key": "e"},
  {"key": "r"},
  {"key": "t"},
  {"key": "y"},
  {"key": "u"},
  {"key": "i"},
  {"key": "o"},
  {"key": "p"},
  {"key": "?"},
  {"key": ","},
  {"key": "~"},
  {"key": "\""},
  {"newline": 1},

  // Home row, indented by one key and closed with Backspace.
  {"blank": 4},
  {"key": "a"},
  {"key": "s"},
  {"key": "d"},
  {"key": "f"},
  {"key": "g"},
  {"key": "h"},
  {"key": "j"},
  {"key": "k"},
  {"key": "l"},
  {"key": "("},
  {"key": ")"},
  {"key": "BSpace", "size": {"width": 9, "height": 3}},
  {"newline": 1},

  // Bottom row: the thumb keys sit under the middle of the letters.
  {"blank": 8},
  {"key": "z"},
  {"key": "x"},
  {"key": "c"},
  {"key": "v"},
  {"key": "b"},
  {"key": "n"},
  {"key": "m"},
  {"blank": 1},
  {"key": "C-", "size": {"width": 4, "height": 3}},
  {"key": " ", "size": {"width": 13, "height": 3}},
  {"key": "Enter", "size": {"width": 7, "height": 3}},
  {"newline": 1},

  // Arrow row, out at the right end where it does not crowd the letters.
  {"blank": 44},
  {"key": "Left", "size": {"width": 7, "height": 3}},
  {"key": "Down", "size": {"width": 7, "height": 3}},
  {"key": "Up", "size": {"width": 7, "height": 3}},
  {"key": "Right", "size": {"width": 7, "height": 3}},
]
