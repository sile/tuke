[
  // A compact QWERTY keyboard for narrow screens: every key in this layout
  // fits within 80 columns. It carries the keys a shell needs most often and
  // leaves the rest (Shift, Alt) to a fuller layout chosen by hand.
  //
  // The keys are five columns wide, which is narrow but still wide enough to
  // read a one-character label without the key looking cramped. The rows run
  // top to bottom: symbols, digits, then the three letter rows, and finally
  // the arrows and the thumb keys.

  // Symbol row: every symbol this layout carries, gathered up here so the
  // letter rows stay narrow. It is centred over the rows below.
  {"base_position": {"row": 0, "column": 0}},
  {"default_size": {"width": 5, "height": 3}},
  {"blank": 7},
  {"key": "\""},
  {"key": "."},
  {"key": "/"},
  {"key": "?"},
  {"key": "("},
  {"key": ")"},
  {"key": "-"},
  {"key": "_"},
  {"key": "~"},
  {"newline": 1},

  // Number row.
  {"key": "Esc", "size": {"width": 9, "height": 3}},
  {"key": "1"},
  {"key": "2"},
  {"key": "3"},
  {"key": "4"},
  {"key": "5"},
  {"key": "6"},
  {"key": "7"},
  {"key": "8"},
  {"key": "9"},
  {"key": "0"},
  {"newline": 1},

  // Upper letter row.
  {"key": "Tab", "size": {"width": 9, "height": 3}},
  {"key": "q"},
  {"key": "w"},
  {"key": "e"},
  {"key": "r"},
  {"key": "t"},
  {"key": "y"},
  {"key": "u"},
  {"key": "i"},
  {"key": "o"},
  {"key": "p"},
  {"newline": 1},

  // Home row, indented by one key.
  {"blank": 4},
  {"key": "a"},
  {"key": "s"},
  {"key": "d"},
  {"key": "f"},
  {"key": "g"},
  {"key": "h"},
  {"key": "j"},
  {"key": "k"},
  {"key": "l"},
  {"newline": 1},

  // Lower row: Ctrl to the left of z, and the up arrow above the down arrow,
  // out at the right of the letters.
  {"key": "C-", "size": {"width": 9, "height": 3}},
  {"key": "z"},
  {"key": "x"},
  {"key": "c"},
  {"key": "v"},
  {"key": "b"},
  {"key": "n"},
  {"key": "m"},
  {"key": "Up", "size": {"width": 7, "height": 3}},
  {"newline": 1},

  // Thumb row, directly under the letters: Backspace to the left of Space,
  // Enter to the right, and the rest of the arrow cluster under Up.
  {"blank": 1},
  {"key": "BSpace", "size": {"width": 9, "height": 3}},
  {"key": " ", "size": {"width": 19, "height": 3}},
  {"key": "Enter", "size": {"width": 9, "height": 3}},
  {"blank": 3},
  {"key": "Left", "size": {"width": 7, "height": 3}},
  {"key": "Down", "size": {"width": 7, "height": 3}},
  {"key": "Right", "size": {"width": 7, "height": 3}},
]
